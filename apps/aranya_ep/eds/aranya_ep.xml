<?xml version="1.0" encoding="UTF-8"?>
<!--
  EDS for ARANYA_EP cFS Application
  Modeled after sample_app.xml template.
  Adjust / extend payloads and command set as the application matures.
-->
<PackageFile xmlns="http://www.ccsds.org/schema/sois/seds">
  <Package name="ARANYA_EP" shortDescription="Aranya Endpoint Application Package">

    <DataTypeSet>
      <!-- Housekeeping payload -->
      <ContainerDataType name="HkTlm_Payload" shortDescription="Aranya EP Housekeeping Content">
        <EntryList>
          <Entry name="CommandCounter" type="BASE_TYPES/uint8" />
          <Entry name="CommandErrorCounter" type="BASE_TYPES/uint8" />
          <!-- Add additional health/status fields here -->
        </EntryList>
      </ContainerDataType>

      <!-- Base command header inheritance -->
      <ContainerDataType name="CommandBase" baseType="CFE_HDR/CommandHeader">
      </ContainerDataType>

      <!-- Send HK command (no extra payload) -->
      <ContainerDataType name="SendHkCmd" baseType="CFE_HDR/CommandHeader">
      </ContainerDataType>

      <!-- Housekeeping telemetry -->
      <ContainerDataType name="HkTlm" baseType="CFE_HDR/TelemetryHeader">
        <EntryList>
          <Entry type="HkTlm_Payload" name="Payload" />
        </EntryList>
      </ContainerDataType>

      <!-- Standard NOOP command -->
      <ContainerDataType name="NoopCmd" baseType="CommandBase">
        <ConstraintSet>
          <ValueConstraint entry="Sec.FunctionCode" value="0" />
        </ConstraintSet>
      </ContainerDataType>

      <!-- Standard Reset Counters command -->
      <ContainerDataType name="ResetCountersCmd" baseType="CommandBase">
        <ConstraintSet>
          <ValueConstraint entry="Sec.FunctionCode" value="1" />
        </ConstraintSet>
      </ContainerDataType>

      <!-- Placeholder for a processing / service command (adjust/remove if unused) -->
      <!-- <ContainerDataType name="ProcessCmd" baseType="CommandBase">
        <ConstraintSet>
          <ValueConstraint entry="Sec.FunctionCode" value="2" />
        </ConstraintSet>
      </ContainerDataType>
    </DataTypeSet> -->

    <ComponentSet>
      <Component name="Application">
        <RequiredInterfaceSet>
          <Interface name="CMD" shortDescription="Software bus telecommand interface" type="CFE_SB/Telecommand">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelecommandDataType" type="CommandBase" />
            </GenericTypeMapSet>
          </Interface>
          <Interface name="SEND_HK" shortDescription="Send housekeeping command interface" type="CFE_SB/Telecommand">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelecommandDataType" type="SendHkCmd" />
            </GenericTypeMapSet>
          </Interface>
          <Interface name="HK_TLM" shortDescription="Housekeeping telemetry interface" type="CFE_SB/Telemetry">
            <GenericTypeMapSet>
              <GenericTypeMap name="TelemetryDataType" type="HkTlm" />
            </GenericTypeMapSet>
          </Interface>
        </RequiredInterfaceSet>
        <Implementation>
          <VariableSet>
            <Variable type="BASE_TYPES/uint16" readOnly="true" name="CmdTopicId"     initialValue="${CFE_MISSION/ARANYA_EP_CMD_TOPICID}" />
            <Variable type="BASE_TYPES/uint16" readOnly="true" name="SendHkTopicId"  initialValue="${CFE_MISSION/ARANYA_EP_SEND_HK_TOPICID}" />
            <Variable type="BASE_TYPES/uint16" readOnly="true" name="HkTlmTopicId"   initialValue="${CFE_MISSION/ARANYA_EP_HK_TLM_TOPICID}" />
          </VariableSet>
          <ParameterMapSet>
            <ParameterMap interface="CMD"     parameter="TopicId" variableRef="CmdTopicId" />
            <ParameterMap interface="SEND_HK" parameter="TopicId" variableRef="SendHkTopicId" />
            <ParameterMap interface="HK_TLM"  parameter="TopicId" variableRef="HkTlmTopicId" />
          </ParameterMapSet>
        </Implementation>
      </Component>
    </ComponentSet>

  </Package>
</PackageFile>
